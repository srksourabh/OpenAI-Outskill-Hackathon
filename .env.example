# Copy this file to .env for local development.
# Keep real secrets out of version control.

APP_ENV=development
LOG_LEVEL=info
APP_BASE_URL=http://localhost:3000
CRON_SECRET=replace-with-local-placeholder

DATABASE_URL=postgresql://user:password@localhost:5432/outbound_agent
OPENAI_API_KEY=replace-with-openai-api-key
OPENAI_REALTIME_MODEL=gpt-realtime-2
OPENAI_REALTIME_VOICE=marin
OPENAI_REALTIME_FALLBACK_VOICE=cedar

PRIMARY_CALL_LANGUAGE=hi
SUPPORTED_CALL_LANGUAGES=hi,en,bn,pa,gu,mr,ta,te,ml,kn,or,as

TELEPHONY_PROVIDER=plivo

PLIVO_AUTH_ID=replace-with-plivo-auth-id
PLIVO_AUTH_TOKEN=replace-with-plivo-auth-token
PLIVO_NUMBER=replace-with-plivo-number
PLIVO_WEBHOOK_SECRET=replace-with-plivo-webhook-secret

# Optional managed voice-agent fallback.
ULTRAVOX_API_KEY=replace-with-ultravox-api-key
ULTRAVOX_BASE_URL=https://api.ultravox.ai/api
ULTRAVOX_AGENT_ID=replace-with-ultravox-agent-id
ULTRAVOX_VOICE_ID=replace-with-ultravox-voice-id
ULTRAVOX_PLIVO_ENABLED=false

# Future provider placeholders. Not required for the Plivo-first MVP.
TWILIO_ACCOUNT_SID=replace-with-twilio-account-sid
TWILIO_AUTH_TOKEN=replace-with-twilio-auth-token
TWILIO_NUMBER=replace-with-twilio-number
EXOTEL_API_KEY=replace-with-exotel-api-key
EXOTEL_API_TOKEN=replace-with-exotel-api-token
EXOTEL_SID=replace-with-exotel-sid
EXOTEL_NUMBER=replace-with-exotel-number
