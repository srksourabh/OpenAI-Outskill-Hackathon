# Copy this file to .env for local development.
# Keep real secrets out of version control.

APP_ENV=development
LOG_LEVEL=info
APP_BASE_URL=http://localhost:3000
CRON_SECRET=replace-with-local-placeholder

DATABASE_URL=postgresql://user:password@localhost:5432/outbound_agent
OPENAI_API_KEY=replace-with-openai-api-key

TELEPHONY_PROVIDER=plivo

TWILIO_ACCOUNT_SID=replace-with-twilio-account-sid
TWILIO_AUTH_TOKEN=replace-with-twilio-auth-token
TWILIO_NUMBER=replace-with-twilio-number

PLIVO_AUTH_ID=replace-with-plivo-auth-id
PLIVO_AUTH_TOKEN=replace-with-plivo-auth-token
PLIVO_NUMBER=replace-with-plivo-number

EXOTEL_API_KEY=replace-with-exotel-api-key
EXOTEL_API_TOKEN=replace-with-exotel-api-token
EXOTEL_SID=replace-with-exotel-sid
EXOTEL_NUMBER=replace-with-exotel-number
